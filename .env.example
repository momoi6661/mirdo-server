APP_HOST=127.0.0.1
APP_PORT=5678
APP_RELOAD=false

API_BASE_URL=https://api.openai.com/v1
API_KEY=
CHAT_MODEL=gpt-4o-mini

KNOWLEDGE_DIR=data/knowledge
RUNTIME_DIR=data/runtime
CONVERSATION_DB=data/runtime/conversations.sqlite3
CHROMA_DIR=data/runtime/chroma

TOP_K=4
TEMPERATURE=0.4
REQUEST_TIMEOUT=45
CHAT_MAX_TOKENS=360
CONTEXT_WINDOW_TURNS=8
# 上下文引擎预算：历史完整保存在 SQLite，只限制发给模型的本回合内容。
CHAT_CONTEXT_RECENT_MESSAGES=6
CHAT_CONTEXT_MEMORY_HITS=3
CHAT_CONTEXT_KNOWLEDGE_HITS=2
CHAT_CONTEXT_STORY_HITS=2

# VOICEVOX：ChatRequest.use_tts 默认 false；请求明确传 true 时才生成语音。
TTS_ENABLED=true
TTS_ENGINE_URL=http://127.0.0.1:50021
TTS_CACHE_ENABLED=true
TTS_PROFILE_DIR=data/tts/characters
TTS_DIALOGUE_DIR=data/dialogue
