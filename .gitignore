# Python / test cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env / local env
.venv/
venv/
.env
.env.*
!.env.example

# Runtime state, logs, generated DB/audio
data/runtime/
data/models/fastembed/
*.log
*.sqlite3
*.db
*.wav
*.mp3
*.ogg

# Keep versioned TTS/profile definitions, ignore generated audio only.
!data/tts/
!data/tts/**/
!data/tts/**/*.json
!data/tts/**/*.md

# Local IDE / automation
.idea/
.vscode/
.codex_tmp/
.learnings/
.omd/

